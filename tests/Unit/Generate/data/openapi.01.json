    "/api/tenant/profile": {
      "get": {
        "tags": [
          "tenant"
        ],
        "summary": "Get current tenant profile",
        "description": "Even though the router already requires a user token,\ninjecting the SAME dependency here gives us the cached Principal.",
        "operationId": "tenant.Profile",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Tenant.Profile"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/tenant/runs": {
      "get": {
        "tags": [
          "tenant"
        ],
        "summary": "List my runs",
        "description": "User-only listing.",
        "operationId": "tenant.Runs",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Tenant.Runs"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AckResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ResponseStatus",
            "default": "ok"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "title": "AckResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ResponseStatus": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ],
        "title": "ResponseStatus"
      },
      "Tenant": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "type": {
            "$ref": "#/components/schemas/TenantType"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "blocked": {
            "type": "boolean",
            "title": "Blocked"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "type",
          "active",
          "blocked"
        ],
        "title": "Tenant"
      },
      "TenantType": {
        "type": "string",
        "enum": [
          "real",
          "simulated",
          "demo"
        ],
        "title": "TenantType"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "admin",
      "description": "Admin-only operations."
    },
    {
      "name": "tenant",
      "description": "Authenticated tenant operations."
    },
    {
      "name": "health",
      "description": "Health and readiness probes."
    }
  ]
}