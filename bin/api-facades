#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = null;

if (isset($_composer_autoload_path) && is_string($_composer_autoload_path) && is_file($_composer_autoload_path))
{
	$autoload = $_composer_autoload_path;
}
else
{
	foreach ([
		__DIR__ . '/../vendor/autoload.php',
		__DIR__ . '/../../../autoload.php',
	] as $candidate)
	{
		if (!is_file($candidate))
		{
			continue;
		}
		$autoload = $candidate;
		break;
	}
}

if ($autoload === null)
{
	fwrite(STDERR, "Unable to locate Composer autoloader.\n");
	exit(1);
}

require $autoload;

exit(Maslosoft\ApiFacades\Console\ApplicationFactory::create()->run());
